# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID, found on the same "General Information" page
CLIENT_ID=your-application-id-here

# Optional: set this to your server ID while developing.
# Guild-scoped commands register instantly; without it, commands are
# registered globally and can take up to an hour to show up everywhere.
GUILD_ID=your-server-id-here

# Role ID allowed to use /addflow and /subflow (the Mizu Evaluation Team role).
# Right-click the role in Discord (with Developer Mode on) -> Copy Role ID.
EVALUATOR_ROLE_ID=your-role-id-here
